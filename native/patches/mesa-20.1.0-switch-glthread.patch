+// glthread calls this on its worker thread at startup (st_set_background_context
+// dereferences it unconditionally). No window-system state to set up; just keep the
+// worker off the application's main core (0) and at the main thread's priority.
+// The launcher's sampling profiler (measurement builds only) can also sample this thread.
+extern void nx_profiler_add_thread(uint32_t thread_handle) __attribute__((weak));
+
+static void
+switch_st_set_background_context(struct st_context_iface *stctx, struct util_queue_monitoring *queue_info)
+{
+    // MESA_GLTHREAD_CORE picks the worker's core (default 1); it must be in the process core mask.
+    int core = (int)debug_get_num_option("MESA_GLTHREAD_CORE", 1);
+    u64 core_mask = 0;
+    if (core >= 0 && core < 64 && R_SUCCEEDED(svcGetInfo(&core_mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0))
+        && (core_mask & (1ull << core)))
+        svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, core_mask);
+    svcSetThreadPriority(CUR_THREAD_HANDLE, 0x2C);
+    if (nx_profiler_add_thread)
+        nx_profiler_add_thread(threadGetCurHandle());
+}
+
