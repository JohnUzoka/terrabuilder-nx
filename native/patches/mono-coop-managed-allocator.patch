diff --git a/src/mono/mono/metadata/sgen-client-mono.h b/src/mono/mono/metadata/sgen-client-mono.h
index f20831112ec..45f0f07cc38 100644
--- a/src/mono/mono/metadata/sgen-client-mono.h
+++ b/src/mono/mono/metadata/sgen-client-mono.h
@@ -696,8 +696,11 @@ sgen_client_binary_protocol_ephemeron_ref (gpointer list, gpointer key, gpointer
  * We can only use a critical region in the managed allocator if the JIT supports OP_ATOMIC_STORE_I4.
  *
  * TODO: Query the JIT instead of this ifdef hack.
+ *
+ * Under full cooperative suspend a RUNNING thread is never interrupted, and the
+ * allocator fast path has no safepoint, so the flag is never observed set.
  */
-#if defined (TARGET_X86) || defined (TARGET_AMD64) || (defined (TARGET_ARM) && defined (HAVE_ARMV7)) || defined (TARGET_ARM64) || defined (TARGET_RISCV)
+#if !defined (ENABLE_COOP_SUSPEND) && (defined (TARGET_X86) || defined (TARGET_AMD64) || (defined (TARGET_ARM) && defined (HAVE_ARMV7)) || defined (TARGET_ARM64) || defined (TARGET_RISCV))
 #define MANAGED_ALLOCATOR_CAN_USE_CRITICAL_REGION
 #endif
 #endif
diff --git a/src/mono/mono/mini/mini-llvm.c b/src/mono/mono/mini/mini-llvm.c
index 8cc8c986381..0a4bd79dc9d 100644
--- a/src/mono/mono/mini/mini-llvm.c
+++ b/src/mono/mono/mini/mini-llvm.c
@@ -7687,6 +7687,16 @@ MONO_RESTORE_WARNING
 			break;
 		}
 		case OP_MEMORY_BARRIER: {
+#ifdef TARGET_ARM64
+			/*
+			 * The managed allocator's release barrier only has to order the vtable/length
+			 * stores before the store that publishes the object, so store-store is enough.
+			 */
+			if (cfg->method->wrapper_type == MONO_WRAPPER_ALLOC && ins->backend.memory_barrier_kind == MONO_MEMORY_BARRIER_REL) {
+				mono_llvm_inline_asm (builder, LLVMFunctionType0 (LLVMVoidType (), FALSE), "dmb ishst", "~{memory}", LLVM_ASM_SIDE_EFFECT, NULL, 0, "");
+				break;
+			}
+#endif
 			mono_llvm_build_fence (builder, (BarrierKind) ins->backend.memory_barrier_kind);
 			break;
 		}
