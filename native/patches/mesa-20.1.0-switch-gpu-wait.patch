+// Make the GPU, not the CPU, wait for a fence (e.g. a swapchain buffer's release): host methods
+// SyncpointPayload (0x70) and Syncpoint (0x74) with operation Wait and WaitSwitch, as in
+// deko3d's Queue::waitFence and nvgpu's syncpoint wait command.
+PUBLIC void
+nouveau_switch_context_wait_fence(struct pipe_context *pipe, const NvMultiFence *mf)
+{
+	struct nouveau_pushbuf *push = nouveau_context(pipe)->pushbuf;
+	for (u32 i = 0; i < mf->num_fences; i++) {
+		const NvFence *f = &mf->fences[i];
+		if ((s32)f->id < 0)
+			continue;
+		PUSH_SPACE(push, 3);
+		PUSH_DATA(push, 0x20000000 | (2 << 16) | (0x70 >> 2));
+		PUSH_DATA(push, f->value);
+		PUSH_DATA(push, (f->id << 8) | 0x10);
+	}
+}
