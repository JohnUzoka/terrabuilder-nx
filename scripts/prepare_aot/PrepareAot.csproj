<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PrepareAot.cs" />
    <Reference Include="Mono.Cecil">
      <HintPath>$(CecilPath)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateCecilPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CecilPath)' == ''" Text="Provide -p:CecilPath=/absolute/path/to/Mono.Cecil.dll" />
    <Error Condition="'$(CecilPath)' != '' and !Exists('$(CecilPath)')" Text="CecilPath does not exist: $(CecilPath)" />
  </Target>
</Project>
