<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireCecil" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CecilPath)' == '' Or !Exists('$(CecilPath)')" Text="Provide -p:CecilPath=/absolute/path/Mono.Cecil.dll" />
  </Target>
</Project>
