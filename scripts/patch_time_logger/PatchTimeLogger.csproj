<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="ValidateCecilPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CecilPath)' == '' or !Exists('$(CecilPath)')" Text="Provide -p:CecilPath=/absolute/path/to/Mono.Cecil.dll" />
  </Target>
</Project>
