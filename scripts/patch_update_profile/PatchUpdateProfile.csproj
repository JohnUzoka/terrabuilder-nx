<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Deterministic>true</Deterministic>
    <StartupObject>Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../patch_tile_profile/Common.cs" Link="Common.cs" />
    <Compile Include="../patch_time_logger/PeResources.cs" Link="PeResources.cs" />
    <Compile Include="../patch_render_profile/RenderRawSignatures.cs" Link="RenderRawSignatures.cs" />
    <AssemblyMetadata Include="Update56SourceManifest" Value="$(SourceManifestHash)" />
    <AssemblyMetadata Include="Update56SupportArtifact" Value="$(SupportArtifactHash)" />
    <Reference Include="PatchFrameProfile"><HintPath>$(FrameToolPath)</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="ValidateDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CecilPath)' == '' or !Exists('$(CecilPath)')" Text="Provide pinned target SDK CecilPath" />
    <Error Condition="'$(FrameToolPath)' == '' or !Exists('$(FrameToolPath)')" Text="Provide reviewed FrameToolPath" />
    <Error Condition="'$(SourceManifestHash)' == ''" Text="Provide build-bound SourceManifestHash" />
    <Error Condition="'$(SupportArtifactHash)' == ''" Text="Provide build-bound SupportArtifactHash" />
  </Target>
</Project>
