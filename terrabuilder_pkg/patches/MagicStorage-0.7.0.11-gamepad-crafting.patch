+using Microsoft.Xna.Framework.Input;
+using Terraria;
+
+namespace MagicStorage.Common.Systems;
+
+/// <summary>
+/// Left-button state for the crafting buttons. <see cref="StorageGUI.curMouse"/> is the raw <see cref="Mouse.GetState"/>,
+/// which only a physical mouse (or touch mapped to the mouse) drives; gamepad clicks reach the game through
+/// PlayerInput's MouseLeft trigger, i.e. <see cref="Main.mouseLeft"/>. A button counts as held when either source holds it,
+/// so mouse input behaves exactly as before.
+/// </summary>
+internal static class CraftingInput {
+	private static bool leftHeld, leftHeldLastUpdate;
+
+	/// <summary>Called once per <see cref="MagicUI.UpdateUI"/>, right after <see cref="StorageGUI.curMouse"/> is polled.</summary>
+	public static void Update() {
+		leftHeldLastUpdate = leftHeld;
+		leftHeld = StorageGUI.curMouse.LeftButton == ButtonState.Pressed || Main.mouseLeft;
+	}
+
+	public static bool LeftHeld => leftHeld;
+
+	public static bool LeftHeldLastUpdate => leftHeldLastUpdate;
+
+	public static bool LeftClicked => leftHeld && !leftHeldLastUpdate;
+}
